# Step 1 — Bake a pinned skill pack into a worker image.
FROM node:22-bookworm-slim

ARG PACK_REPO=letslego/insurance-agent-skills
ARG PACK_REF=main
ARG DESK=claims-intake

WORKDIR /workspace
COPY promoted-skills.json /tmp/promoted-skills.json
COPY install-pinned.sh /tmp/install-pinned.sh
RUN chmod +x /tmp/install-pinned.sh \
  && PACK_REPO=$PACK_REPO PACK_REF=$PACK_REF DESK=$DESK TARGET_DIR=/workspace \
     PROMOTED_FILE=/tmp/promoted-skills.json /tmp/install-pinned.sh

# Runtime image later COPY --from=this /workspace/.agents /app/.agents
